rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /rooms/{roomId} {
      function isVerified() {
        return request.auth != null && request.auth.token.email_verified == true;
      }

      function friendshipIdWith(creatorId) {
        return request.auth.uid < creatorId
          ? request.auth.uid + '___' + creatorId
          : creatorId + '___' + request.auth.uid;
      }

      function isFriendOfCreator() {
        let fid = friendshipIdWith(resource.data.createdBy);
        return exists(/databases/$(database)/documents/friendships/$(fid))
          && get(/databases/$(database)/documents/friendships/$(fid)).data.status == 'accepted';
      }

      function isInvolvedWithRoom() {
        return request.auth.uid in resource.data.get('participants', [])
          || request.auth.uid in resource.data.get('requests', [])
          || request.auth.uid in resource.data.get('invites', []);
      }

      function canReadRoom() {
        return isVerified()
          && (resource.data.createdBy == request.auth.uid
              || resource.data.get('visibility', 'public') != 'private'
              || isFriendOfCreator()
              || isInvolvedWithRoom());
      }

      allow read: if canReadRoom();
      allow write: if isVerified();

      match /messages/{messageId} {
        allow read, write: if request.auth != null && request.auth.token.email_verified == true;
      }

      match /participants/{participantId} {
        allow read, write: if request.auth != null && request.auth.token.email_verified == true;
      }
    }

    match /users/{userId} {
      function isVerified() {
        return request.auth != null && request.auth.token.email_verified == true;
      }

      allow create: if request.auth != null && request.auth.uid == userId;
      allow read: if isVerified();
      allow update, delete: if isVerified() && request.auth.uid == userId;
    }

    match /loginHandles/{handle} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string;
      allow update, delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    match /notifications/{notificationId} {
      allow read, write: if request.auth != null && request.auth.token.email_verified == true;
    }

    match /reports/{reportId} {
      allow read, write: if request.auth != null && request.auth.token.email_verified == true;
    }

    match /blocks/{blockId} {
      function isVerified() {
        return request.auth != null && request.auth.token.email_verified == true;
      }

      allow read: if isVerified() && resource.data.blockerId == request.auth.uid;
      allow create: if isVerified()
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedId is string;
      allow delete: if isVerified() && resource.data.blockerId == request.auth.uid;
    }

    match /friendships/{friendshipId} {
      function isVerified() {
        return request.auth != null && request.auth.token.email_verified == true;
      }

      function isParticipant() {
        return isVerified()
          && (resource.data.user1Id == request.auth.uid
              || resource.data.user2Id == request.auth.uid);
      }

      function isParticipantByDocId() {
        return isVerified()
          && (friendshipId.matches('^' + request.auth.uid + '___.*')
              || friendshipId.matches('.*___' + request.auth.uid + '$'));
      }

      allow read: if isVerified()
        && (resource == null ? isParticipantByDocId() : isParticipant());

      allow create: if isVerified()
        && request.resource.data.requestedBy == request.auth.uid
        && (request.resource.data.user1Id == request.auth.uid
            || request.resource.data.user2Id == request.auth.uid)
        && request.resource.data.status == 'pending';

      allow update: if isVerified()
        && isParticipant()
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && resource.data.requestedBy != request.auth.uid;

      allow delete: if isVerified() && isParticipant();
    }

    match /posts/{postId} {
      function isVerified() {
        return request.auth != null && request.auth.token.email_verified == true;
      }

      function isSocialUpdate() {
        let keys = request.resource.data.diff(resource.data).affectedKeys();
        return keys.hasOnly(['likes'])
          || keys.hasOnly(['reactions'])
          || keys.hasOnly(['commentsCount']);
      }

      allow read: if isVerified();

      allow create: if isVerified()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.likes.size() == 0
        && request.resource.data.commentsCount == 0;

      allow update: if isVerified() && (
        resource.data.userId == request.auth.uid
        || isSocialUpdate()
      );

      allow delete: if isVerified() && resource.data.userId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if isVerified();
        allow create: if isVerified()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.text is string;
        allow delete: if isVerified() && resource.data.userId == request.auth.uid;
      }
    }

    match /conversations/{conversationId} {
      function isVerified() {
        return request.auth != null && request.auth.token.email_verified == true;
      }

      function friendshipDoc() {
        return get(/databases/$(database)/documents/friendships/$(conversationId));
      }

      function isAcceptedFriend() {
        return exists(/databases/$(database)/documents/friendships/$(conversationId))
          && friendshipDoc().data.status == 'accepted'
          && (request.auth.uid == friendshipDoc().data.user1Id
              || request.auth.uid == friendshipDoc().data.user2Id);
      }

      function isParticipant() {
        return isVerified()
          && (request.auth.uid == resource.data.user1Id
              || request.auth.uid == resource.data.user2Id);
      }

      function isParticipantOnWrite() {
        return isVerified()
          && (request.auth.uid == request.resource.data.user1Id
              || request.auth.uid == request.resource.data.user2Id);
      }

      allow read: if isParticipant();

      allow create, update: if isParticipantOnWrite()
        && isAcceptedFriend()
        && request.resource.data.user1Id is string
        && request.resource.data.user2Id is string
        && request.resource.data.lastMessage is string;

      match /messages/{messageId} {
        function canAccessMessages() {
          return isVerified() && (
            isAcceptedFriend()
            || (exists(/databases/$(database)/documents/conversations/$(conversationId))
                && (request.auth.uid == get(/databases/$(database)/documents/conversations/$(conversationId)).data.user1Id
                    || request.auth.uid == get(/databases/$(database)/documents/conversations/$(conversationId)).data.user2Id))
          );
        }

        allow read: if canAccessMessages();

        allow create: if isVerified()
          && isAcceptedFriend()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.senderName is string;
      }
    }

    match /friendNotifications/{notificationId} {
      allow read, update: if request.auth != null
        && request.auth.token.email_verified == true
        && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null
        && request.auth.token.email_verified == true
        && request.resource.data.senderId == request.auth.uid;

      allow delete: if request.auth != null
        && request.auth.token.email_verified == true
        && resource.data.userId == request.auth.uid;
    }
  }
}
